# =============================================================================
# RetractWatch Environment Configuration
# =============================================================================

# Convex Realtime Backend (Required for live jobs and results dashboard)
# Run `npm run convex` or `npx convex dev` to obtain your dev deployment URL
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# LLM Provider for PDF / Bibliography Extraction (Required for PDF extraction)
# Supports OpenAI, Groq, DeepSeek, Ollama, xAI, etc.
OPENAI_API_KEY=your_openai_api_key_here
# LLM_API_KEY=your_alternative_llm_key_here

# Optional: Custom LLM Base URL & Model (e.g. Groq, local Ollama, etc.)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_JSON_MODE=true
# LLM_MAX_COMPLETION_TOKENS=8192

# Semantic Scholar API Key (Recommended to prevent rate limits on citation cascade graphs)
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# Exa AI API Key (Optional for clean replacement literature search)
EXA_API_KEY=your_exa_api_key_here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
